rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Funções auxiliares ───────────────────────────────────────────────────

    // Verifica que um campo não foi alterado numa escrita (imutabilidade).
    // Aceita ausência do campo na escrita (merge parcial sem o campo é seguro).
    function fieldUnchanged(field) {
      return !(field in request.resource.data)
          || request.resource.data[field] == resource.data[field];
    }

    // ─── users ────────────────────────────────────────────────────────────────
    // Cada utilizador acede apenas ao seu próprio documento.
    // 'email' e 'id' são imutáveis pelo cliente — gerados pelo Firebase Auth e Firestore.
    match /users/{userId} {
      allow read:   if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && fieldUnchanged('email')
        && fieldUnchanged('id');
      allow delete: if false;
    }

    // ─── tasks ────────────────────────────────────────────────────────────────
    // Filtradas por userId no documento. userId é imutável após a criação.
    match /tasks/{taskId} {
      allow read:   if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.userId;

      // steps — SUB-COLLECTION LEGADA (ADR-023 / ADR-024).
      // Contrato atual: campo array 'steps' no documento da tarefa.
      // Nenhum cliente (Web ou Mobile) lê ou escreve esta sub-collection.
      // Dados legados existentes são ignorados — acesso negado a todos os clientes.
      match /steps/{stepId} {
        allow read, write: if false;
      }
    }

    // ─── preferences ──────────────────────────────────────────────────────────
    // Documento 1:1 com o utilizador (document ID == userId). userId imutável.
    match /preferences/{userId} {
      allow read:   if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && fieldUnchanged('userId');
      allow delete: if false;
    }

    // ─── onboarding ───────────────────────────────────────────────────────────
    // Documento 1:1 com o utilizador (document ID == userId). userId imutável.
    match /onboarding/{userId} {
      allow read:   if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && fieldUnchanged('userId');
      allow delete: if false;
    }

    // ─── reminders ────────────────────────────────────────────────────────────
    // Filtrados por userId no documento. userId imutável após criação.
    match /reminders/{reminderId} {
      allow read:   if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // ─── history ──────────────────────────────────────────────────────────────
    // Eventos de atividade (ADR-017). userId imutável. Sem delete pelo cliente
    // — o histórico é imutável para preservar a integridade de streak/semana.
    match /history/{historyId} {
      allow read:   if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId;
      allow delete: if false;
    }

    // ─── notifications ────────────────────────────────────────────────────────
    // Histórico de pushes enviados pela Cloud Function.
    // Escrita exclusiva via Admin SDK — nunca pelo cliente.
    // Cada utilizador lê apenas as suas próprias notificações.
    match /notifications/{notifId} {
      allow read:  if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow write: if false;
    }

    // ─── fcmTokens ────────────────────────────────────────────────────────────
    // Subcollection de tokens FCM por dispositivo.
    // Só o dono (uid == userId do path) pode ler/escrever/excluir.
    match /users/{userId}/fcmTokens/{tokenId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
